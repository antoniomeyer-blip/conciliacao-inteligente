# PostgreSQL (no Vercel, a integração Neon cria DATABASE_URL automaticamente)
DATABASE_URL=postgresql://usuario:senha@host:5432/conciliacao
# Opcional: segredo para assinar as sessões. Se omitido, a aplicação gera um aleatório e o guarda no banco.
JWT_SECRET=troque-por-um-valor-aleatorio-longo
# Permitir que novas empresas se cadastrem pela tela de login
ALLOW_REGISTRATION=true
