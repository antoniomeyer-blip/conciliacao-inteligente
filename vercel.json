{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index.py" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/**",
      "excludeFiles": "{node_modules,.next,public,backend/tests,backend/migrations,scripts}/**"
    }
  }
}
